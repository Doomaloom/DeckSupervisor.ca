        {
          "type": "host",
          "value": "test.decksupervisor.ca"
        }
      ],
      "destination": "https://decksupervisor-develop.fly.dev/api/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "deck-supervisor-ca-git-develop-franks-projects-ff1c4b38.vercel.app"
        }
      ],
      "destination": "https://decksupervisor-develop.fly.dev/api/:path*"
